{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:js": "esbuild src/main.js --minify --target=es2017 --outfile=public/js/main.js",
    "build:css": "tailwindcss -i ./src/style.scss -o ./public/style.min.css --minify && npm run build:css:rtl",
    "build:css:rtl": "rtlcss ./public/style.min.css ./public/style.min-rtl.css",
    "watch:css": "tailwindcss -i ./src/style.scss -o ./public/style.min.css --watch --minify"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "rtlcss": "^4.3.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  },
  "dependencies": {
    "tailwindcss-rtl": "^0.9.0"
  }
}
